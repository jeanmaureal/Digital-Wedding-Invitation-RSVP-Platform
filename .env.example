# Application deployment environment: local | preview | production
# Defaults to "local" when unset. Preview and Production require valid Supabase credentials.
VITE_APP_ENV=local

# Frontend public configuration (embedded in browser bundle — NEVER place secret or service-role keys here)
# In local development without Supabase configured, leave these unset to run the offline application shell.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
